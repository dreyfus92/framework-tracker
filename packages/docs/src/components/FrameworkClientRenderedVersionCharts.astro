---
import type { ChartMeasurement } from '../lib/types'
import {
  prepareClientSideRenderedTestsFcpMsHistory,
  prepareClientSideRenderedTestsFirstPaintMsHistory,
  prepareClientSideRenderedTestsInteractionHistory,
} from '../lib/prepare-chart'
import VersionLineChart from './VersionLineChart.astro'
import InteractionBreakdownChart from './InteractionBreakdownChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props

const interactionData =
  prepareClientSideRenderedTestsInteractionHistory(versions)
---

<VersionLineChart
  {...prepareClientSideRenderedTestsFirstPaintMsHistory(versions)}
/>
<VersionLineChart {...prepareClientSideRenderedTestsFcpMsHistory(versions)} />
{
  interactionData.length > 0 ? (
    <InteractionBreakdownChart
      title="Client Interaction Breakdown by Version"
      data={interactionData}
      orientation="vertical"
    />
  ) : null
}
