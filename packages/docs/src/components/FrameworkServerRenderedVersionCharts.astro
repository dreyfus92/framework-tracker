---
import type { ChartMeasurement } from '../lib/types'
import {
  prepareServerSideRenderedTestsFcpMsHistory,
  prepareServerSideRenderedTestsFirstPaintMsHistory,
  prepareServerSideRenderedTestsInteractionHistory,
} from '../lib/prepare-chart'
import VersionLineChart from './VersionLineChart.astro'
import InteractionBreakdownChart from './InteractionBreakdownChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props

const interactionData =
  prepareServerSideRenderedTestsInteractionHistory(versions)
---

<VersionLineChart
  {...prepareServerSideRenderedTestsFirstPaintMsHistory(versions)}
/>
<VersionLineChart {...prepareServerSideRenderedTestsFcpMsHistory(versions)} />
{
  interactionData.length > 0 ? (
    <InteractionBreakdownChart
      title="Server Interaction Breakdown by Version"
      data={interactionData}
      orientation="vertical"
    />
  ) : null
}
